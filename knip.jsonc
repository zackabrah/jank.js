{
  "$schema": "./node_modules/knip/schema.json",
  // Pinned development-only commit/comparison tools are deliberately retained by the rewrite policy.
  "ignoreDependencies": ["commitizen", "cz-git", "stats-gl", "stats.js"],
  // Browser-evaluated Vite URL, not a Node filesystem import.
  "ignoreUnresolved": ["/packages/jank/src/index.ts", "/examples/ui-library/diagnostic-preview.ts"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "tests/**/*.{ts,mjs}",
        "examples/basic/main.ts",
        "examples/viewer/main.ts",
        "examples/ui-library/showcase.ts",
        "examples/parity/{review,rewrite-panel}.ts",
        "examples/parity/original-panel.js"
      ],
      "project": ["scripts/*.mjs", "tests/**/*.{ts,mjs}", "examples/**/*.{ts,js}"]
    },
    "packages/jank": {
      "entry": ["src/adapters/{webgl2,three-webgpu,three-counters}.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/junkui": {
      "entry": ["src/index.ts", "gallery/gallery.ts"],
      "project": ["src/**/*.ts", "gallery/*.ts"]
    }
  }
}
