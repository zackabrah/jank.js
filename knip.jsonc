{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // Review pages and the standalone viewer are loaded by HTML, not imported.
  "entry": ["src/viewer/entry.tsx", "checks/*.tsx", "cli/bin.ts"],
  // Type declarations for the .mjs scripts that TypeScript sources import.
  "ignore": ["**/*.d.mts"],
  // Required by pnpm docs:captures, which says so when it is missing.
  "ignoreBinaries": ["ffmpeg"],
  "ignoreIssues": {
    // shortcut: the collector stays byte-identical to 0.3.0 for the move; prune its exports after.
    "src/core/*.ts": ["exports"],
    // Named by the published declarations of `frameEvidence`, though nothing imports it directly.
    "src/recording/types.ts": ["types"]
  }
}
