{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "reference/**",
    "dist/**",
    "dist-package/**",
    "artifacts/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "pnpm-lock.yaml",
    "OPEN RECORDING VIEWER.html"
  ],
  "overrides": [
    {
      "files": ["src/viewer/markup.html"],
      "options": {
        "htmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}
