{
  "name": "jank.js",
  "version": "0.2.1-rewrite.4",
  "private": true,
  "type": "module",
  "description": "Local test preview: host-owned profiling, live panel, capture and validated recording files.",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build-css.mjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./adapters/webgl2": {
      "types": "./dist/adapters/webgl2.d.ts",
      "import": "./dist/adapters/webgl2.js"
    },
    "./adapters/three-webgpu": {
      "types": "./dist/adapters/three-webgpu.d.ts",
      "import": "./dist/adapters/three-webgpu.js"
    },
    "./adapters/three-counters": {
      "types": "./dist/adapters/three-counters.d.ts",
      "import": "./dist/adapters/three-counters.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "license": "MIT",
  "devDependencies": {
    "junkui": "workspace:*"
  }
}
