{
  "name": "jank.js",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "biome check . --error-on-warnings",
    "fix": "biome check . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "node --test scripts/release/*.test.mjs scripts/ci/*.test.mjs scripts/readme/*.test.mjs && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:gpu": "playwright test -c playwright.gpu.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:package": "node scripts/package/verify.mjs",
    "build": "pnpm typecheck && pnpm build:package",
    "build:package": "vite build --config vite.library.config.ts && vite build --config vite.cli.config.ts && tsc -p tsconfig.package.json && node scripts/package/assets.mjs && node scripts/build-viewer.mjs",
    "prepack": "pnpm build:package",
    "check": "pnpm verify:boundary && pnpm lint && pnpm knip && pnpm test:run && pnpm build",
    "check:full": "pnpm check && pnpm test:package && pnpm test:e2e",
    "release:prepare": "pnpm check:full && pnpm pack --pack-destination artifacts/npm",
    "docs:chips": "node scripts/readme/update.mjs",
    "docs:captures": "playwright test -c playwright.captures.config.ts",
    "bench": "pnpm build:package && node scripts/benchmark.mjs",
    "jank": "node cli/jank.ts",
    "knip": "knip --no-progress",
    "verify:boundary": "node scripts/verify-boundary.mjs",
    "commit": "cz",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.0.5",
    "@webgpu/types": "0.1.74",
    "commitizen": "4.3.2",
    "cz-git": "1.14.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.1",
    "knip": "6.43.0",
    "preact": "11.1.1",
    "stats.js": "0.17.0",
    "tailwindcss": "4.3.3",
    "three": "0.187.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git",
      "markBreakingChangeMode": true,
      "allowBreakingChanges": [],
      "maxHeaderLength": 72,
      "breaklineNumber": 72
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.24.0",
  "description": "An embeddable performance monitor for browser games and interactive graphics, with nothing else to install.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "author": "Isaac Johnson",
  "homepage": "https://github.com/zackabrah/jank.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zackabrah/jank.js.git"
  },
  "bugs": {
    "url": "https://github.com/zackabrah/jank.js/issues"
  },
  "keywords": [
    "performance",
    "profiler",
    "fps",
    "webgl",
    "webgpu",
    "game-development"
  ],
  "bin": {
    "jank": "dist-package/jank-cli.js"
  },
  "files": [
    "dist-package",
    "licenses",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist-package/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-package/types/index.d.ts",
      "import": "./dist-package/index.js"
    },
    "./style.css": "./dist-package/style.css",
    "./font.css": "./dist-package/font.css",
    "./panel": {
      "types": "./dist-package/types/panel-api.d.ts",
      "import": "./dist-package/panel.js"
    },
    "./gpu": {
      "types": "./dist-package/types/gpu-api.d.ts",
      "import": "./dist-package/gpu.js"
    },
    "./agent": {
      "types": "./dist-package/types/agent-api.d.ts",
      "import": "./dist-package/agent.js"
    },
    "./viewer": {
      "types": "./dist-package/types/viewer/mount.d.ts",
      "import": "./dist-package/viewer.js"
    },
    "./adapters/three": {
      "types": "./dist-package/types/adapters/three.d.ts",
      "import": "./dist-package/adapters/three.js"
    },
    "./adapters/three-host": {
      "types": "./dist-package/types/adapters/three-host.d.ts",
      "import": "./dist-package/adapters/three-host.js"
    },
    "./adapters/three-webgpu": {
      "types": "./dist-package/types/adapters/three-webgpu.d.ts",
      "import": "./dist-package/adapters/three-webgpu.js"
    },
    "./adapters/webgl2": {
      "types": "./dist-package/types/adapters/webgl2.d.ts",
      "import": "./dist-package/adapters/webgl2.js"
    },
    "./viewer.html": "./dist-package/viewer.html"
  }
}
