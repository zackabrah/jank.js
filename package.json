{
  "name": "jank-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "test:contracts": "tsc -p tests/contracts/tsconfig.json --noEmit",
    "check": "biome ci --error-on-warnings . && pnpm typecheck && pnpm test:contracts && pnpm test:tooling",
    "build:types": "pnpm -r build:types",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/three": "0.186.0",
    "@types/web": "0.0.356",
    "@vitest/coverage-v8": "5.0.1",
    "commitizen": "4.3.2",
    "cz-git": "1.14.0",
    "fast-check": "4.10.2",
    "knip": "6.43.0",
    "stats-gl": "4.2.3",
    "stats.js": "0.17.0",
    "three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
