{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/reference",
      "!!**/dist",
      "!!**/dist-package",
      "!!**/artifacts",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!pnpm-lock.yaml",
      "!!docs/readme/*.svg",
      "!!OPEN RECORDING VIEWER.html"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "includes": ["**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc}"],
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "html": {
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true,
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/viewer/markup.html"],
      "html": {
        "formatter": {
          "whitespaceSensitivity": "ignore"
        }
      }
    }
  ]
}
