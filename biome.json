{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!!**/dist", "!!**/coverage", "!!**/artifacts", "!!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "style": {
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useBlockStatements": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useSingleVarDeclarator": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/junkui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["jank.js", "jank.js/**", "**/jank/**", "three", "three/**"],
                    "message": "junkui must be independent of the profiler and renderers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/jank/src/core/**",
        "packages/jank/src/recordings/**",
        "packages/jank/src/analysis/**",
        "packages/jank/src/loading/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "junkui",
                      "junkui/**",
                      "**/junkui/**",
                      "**/panel/**",
                      "**/viewer/**",
                      "**/adapters/**",
                      "three",
                      "three/**",
                      "node:*"
                    ],
                    "message": "Measurement, recording and analysis cannot depend on presentation or renderer adapters."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
