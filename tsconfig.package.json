{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist-package/types",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/index.ts",
    "src/panel-api.ts",
    "src/gpu-api.ts",
    "src/viewer/mount.tsx",
    "src/adapters/*.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "node_modules", "dist", "dist-package"]
}
