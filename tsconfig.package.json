{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist-package/types",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/index.ts", "src/adapters/*.ts"],
  "exclude": ["**/*.test.ts", "node_modules", "dist", "dist-package"]
}
