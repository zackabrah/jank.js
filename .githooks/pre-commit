#!/bin/sh
# The release gate before every commit: boundary, format, lint, types, unit tests with the
# coverage floors in vitest.config.ts, build, the packed-package consumer check and the
# browser suite. Coverage below any floor fails the commit. It checks the working tree, not
# only what is staged. Skip once with `git commit --no-verify`.
set -e

pnpm check
pnpm test:package
# One retry: Playwright still reports a test that passes only on retry as flaky.
pnpm test:e2e --retries=1
